{
  "name": "course-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "build-all": "yarn build && yarn build-storybook",
    "build-storybook": "storybook build --output-dir build/storybook",
    "build-storybook:test": "storybook build --output-dir build/storybook --test",
    "chromatic": "chromatic --project-token $CHROMATIC_PROJECT_TOKEN --exit-zero-on-changes --only-changed",
    "lint": "oxlint --fix . && oxfmt .",
    "lint:check": "oxlint . && oxfmt --check .",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "serve": "vite preview",
    "start": "vite",
    "check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test-storybook": "test-storybook",
    "test-storybook:ci": "concurrently --kill-others --success first --names \"SB,TEST\" --prefix-colors \"magenta,blue\" \"yarn build-storybook:test && npx serve build/storybook --listen 6006 --no-request-logging\" \"wait-on tcp:6006 && yarn test-storybook\"",
    "test-storybook:json": "test-storybook --index-json",
    "test-storybook:json:ci": "concurrently --kill-others --success first --names \"SB,TEST\" --prefix-colors \"magenta,blue\" \"yarn build-storybook:test && npx serve build/storybook --listen 6006 --no-request-logging\" \"wait-on tcp:6006 && SKIP_SNAPSHOTS=true yarn test-storybook:json\"",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt ."
  },
  "lint-staged": {
    "!(mockServiceWorker).{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{html,md,json}": "oxfmt"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "resolutions": {
    "@use-it/event-listener@npm:^0.1.2": "patch:@use-it/event-listener@npm%3A0.1.7#~/.yarn/patches/@use-it-event-listener-npm-0.1.7-56ef42a654.patch"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.18.1",
    "embla-carousel-react": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-hooks-helper": "^1.6.0",
    "react-loading-skeleton": "^3.5.0",
    "react-lottie-player": "^2.1.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2",
    "react-transition-group": "^4.4.5",
    "styled-components": "^6.4.4",
    "stylis": "^4.4.0",
    "typescript": "^7.0.2",
    "use-dark-mode": "^2.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@storybook/test-runner": "^0.24.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-hooks-helper": "^1.6.6",
    "@types/react-redux": "^7.1.34",
    "@types/react-transition-group": "^4.4.12",
    "@types/stylis": "^4.2.7",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "chromatic": "^18.1.0",
    "concurrently": "^10.0.4",
    "eslint-plugin-storybook": "^10.6.0",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "jest-junit": "^17.0.0",
    "lint-staged": "^17.2.0",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.3",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "playwright": "^1.62.0",
    "storybook": "^10.6.0",
    "storybook-addon-test-codegen": "^3.0.4",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "wait-on": "^9.0.1"
  },
  "packageManager": "yarn@4.18.0",
  "msw": {
    "workerDirectory": "public"
  }
}
